{
  "name": "tomfic-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace @tomfic/web run dev",
    "build": "npm run build:web",
    "build:web": "npm --workspace @tomfic/web run build",
    "build:api": "npm --workspace @tomfic/api run build",
    "test:offline": "npm --workspace @tomfic/web run test:offline",
    "test:api": "npm --workspace @tomfic/api run test",
    "test:db": "npm --workspace @tomfic/api run test:db"
  }
}
