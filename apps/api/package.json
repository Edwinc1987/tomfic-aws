{
  "name": "@tomfic/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prebuild": "prisma generate",
    "pretest": "prisma generate",
    "build": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:db": "cross-env RUN_DB_TESTS=1 vitest run src/features/counts/infrastructure/count-concurrency.integration.test.ts src/features/counts/infrastructure/capture-idempotency.integration.test.ts src/features/counts/infrastructure/count-tenant-isolation.integration.test.ts src/features/inventories/infrastructure/inventory-isolation.integration.test.ts src/features/products/infrastructure/product-isolation.integration.test.ts",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.16.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/s3-request-presigner": "^3.896.0",
    "@vendia/serverless-express": "^4.12.6",
    "aws-jwt-verify": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "prisma": "^6.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
