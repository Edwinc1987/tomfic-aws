generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStage {
  PROSPECTO
  DEMO
  PRUEBA
  ACTIVO
  EN_RIESGO
  SUSPENDIDO
  RETIRADO
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CAPTURER
  COMMERCIAL
}

enum CountRoundName {
  C1
  C2
  C3
}

enum CountRoundStatus {
  OPEN
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum HealthRisk {
  HEALTHY
  WATCH
  AT_RISK
  CRITICAL
}

model Tenant {
  id           String       @id @default(uuid())
  name         String
  taxId        String       @unique
  stage        CompanyStage @default(PROSPECTO)
  plan         String       @default("basico")
  monthlyPrice Decimal      @default(0) @db.Decimal(12, 2)
  expiresAt    DateTime?
  active       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  users        User[]
  inventories  Inventory[]
  products     Product[]
  counts       Count[]
  payments     Payment[]
  contacts     Contact[]
  activities   CrmActivity[]
  notes        CompanyNote[]
  tickets      SupportTicket[]
  health       CustomerHealth?
  auditEvents  AuditEvent[]

  @@index([stage])
  @@index([active])
}

model User {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String      @unique
  role         UserRole
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  rounds       CountRound[]
  activities   CrmActivity[]
  notes        CompanyNote[]
  assignedTickets SupportTicket[]
  auditEvents  AuditEvent[]

  @@index([tenantId, role])
}

model Inventory {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  status       String      @default("OPEN")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  products     Product[]
  counts       Count[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model Product {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  code         String    @default("")
  barcode      String    @default("")
  name         String
  balance      Decimal   @default(0) @db.Decimal(14, 3)
  cost         Decimal   @default(0) @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  captures     Capture[]

  @@index([tenantId, inventoryId, name])
  @@index([tenantId, inventoryId, code])
  @@index([tenantId, inventoryId, barcode])
}

model Count {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryId  String
  inventory    Inventory   @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  name         String
  location     String
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  rounds       CountRound[]

  @@index([tenantId, inventoryId, status])
}

model CountRound {
  id           String          @id @default(uuid())
  countId      String
  count        Count           @relation(fields: [countId], references: [id], onDelete: Cascade)
  name         CountRoundName
  status       CountRoundStatus @default(OPEN)
  assignedToId String?
  assignedTo   User?           @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  closedAt     DateTime?
  captures     Capture[]

  @@unique([countId, name])
  @@index([assignedToId, status])
}

model Capture {
  id           String     @id @default(uuid())
  operationId  String     @unique
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  roundId      String
  round        CountRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  quantity     Decimal    @db.Decimal(14, 3)
  condition    String     @default("BUENO")
  capturedAt   DateTime   @default(now())

  @@index([roundId, productId])
}

model Payment {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  receiptKey String?
  note      String?

  @@index([tenantId, paidAt])
}

model Contact {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, name])
}

model CrmActivity {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, dueAt])
  @@index([ownerId, completedAt])
}

model CompanyNote {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
}

model SupportTicket {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    TicketPriority  @default(MEDIUM)
  status      TicketStatus    @default(OPEN)
  assignedToId String?
  assignedTo  User?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  @@index([tenantId, status, priority])
  @@index([assignedToId, status])
}

model CustomerHealth {
  id             String     @id @default(uuid())
  tenantId       String     @unique
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  score          Int        @default(0)
  risk           HealthRisk @default(HEALTHY)
  lastActivityAt DateTime?
  activeUsers    Int        @default(0)
  activeInventories Int     @default(0)
  updatedAt      DateTime   @updatedAt
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
